<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
<title>مكتبتي - بحث متقدم</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Amiri:ital,wght@0,400;0,700;1,400&family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root{ --radius: 3px; }

  body[data-theme="day"]{
    --bg:#f4f0e4; --bg-2:#ece5d2; --surface:#fffdf7; --ink:#262119; --ink-soft:#5b5240;
    --accent:#7a2e4e; --accent-2:#c69a3a; --line:#d9cfb2; --page-bg:#fffdf6; --shadow:rgba(38,33,25,0.28);
  }
  body[data-theme="night"]{
    --bg:#14171a; --bg-2:#1b1f23; --surface:#20252a; --ink:#e9e4d6; --ink-soft:#a8a190;
    --accent:#d68fae; --accent-2:#4f9c8a; --line:#34393f; --page-bg:#1c2024; --shadow:rgba(0,0,0,0.55);
  }
  body[data-theme="sepia"]{
    --bg:#e6d7b3; --bg-2:#ddccA0; --surface:#f1e5bf; --ink:#3c2e18; --ink-soft:#6b5a37;
    --accent:#8a3b5a; --accent-2:#4b6b45; --line:#cbb680; --page-bg:#f7ecc9; --shadow:rgba(60,46,24,0.35);
  }

  *{ box-sizing:border-box; }
  html,body{ height:100%; margin:0; }
  body{
    background:var(--bg); color:var(--ink); font-family:'Amiri', serif;
    transition: background .35s ease, color .35s ease; overflow:hidden;
  }
  button, input{ font-family:'Cairo', sans-serif; }
  ::-webkit-scrollbar{ width:8px; height:8px; }
  ::-webkit-scrollbar-thumb{ background:var(--line); border-radius:10px; }

  .app{ display:flex; flex-direction:column; height:100dvh; }

  /* ===== شريط علوي ===== */
  .topbar{
    flex:none; display:flex; align-items:center; gap:10px; padding:10px 18px;
    background:var(--surface); border-bottom:1px solid var(--line); z-index:40;
    position:relative;
  }
  .brand{ display:flex; align-items:center; gap:10px; cursor:pointer; }
  .brand .mark{
    width:30px; height:30px; border-radius:50%; border:1.5px solid var(--accent-2);
    display:flex; align-items:center; justify-content:center; color:var(--accent);
    font-family:'Aref Ruqaa', serif; font-size:1rem; flex:none;
  }
  .brand b{ font-family:'Aref Ruqaa', serif; font-size:1.25rem; color:var(--ink); }

  .tb-sep{ width:1px; align-self:stretch; background:var(--line); margin:2px 4px; }

  .search-wrap{
    position:relative; margin-inline-start:6px; flex:1; max-width:320px;
  }
  .search-wrap svg{
    position:absolute; inset-inline-start:10px; top:50%; transform:translateY(-50%);
    width:16px; height:16px; color:var(--ink-soft); pointer-events:none;
  }
  .search-wrap input{
    width:100%; padding:8px 12px 8px 12px; padding-inline-start:34px;
    border:1px solid var(--line); border-radius:20px; background:var(--bg);
    color:var(--ink); font-size:0.88rem;
  }
  .search-wrap input:focus{ outline:2px solid var(--accent); }

  /* قائمة نتائج البحث */
  #searchResults {
    position:absolute; top:calc(100% + 6px); inset-inline-start:0; width:100%;
    background:var(--surface); border:1px solid var(--line); border-radius:8px;
    box-shadow:0 10px 30px var(--shadow); max-height:300px; overflow-y:auto;
    display:none; z-index:100; padding:8px 0;
  }
  #searchResults .result-item {
    padding:8px 16px; cursor:pointer; border-bottom:1px solid var(--bg-2);
    transition:background 0.15s ease;
  }
  #searchResults .result-item:hover { background:var(--bg-2); }
  #searchResults .result-item .book-title {
    font-weight:600; color:var(--accent); font-size:0.85rem;
  }
  #searchResults .result-item .snippet {
    font-size:0.8rem; color:var(--ink-soft); display:block;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  #searchResults .result-item .snippet mark {
    background:var(--accent-2); color:var(--surface); padding:0 2px; border-radius:2px;
  }
  #searchResults .no-results {
    padding:16px; text-align:center; color:var(--ink-soft); font-size:0.85rem;
  }

  .nav-cluster{ display:flex; align-items:center; gap:6px; margin-inline-start:auto; }

  .theme-switch{ display:flex; gap:4px; background:var(--bg); border:1px solid var(--line); border-radius:20px; padding:3px; }
  .theme-dot{ width:22px; height:22px; border-radius:50%; border:2px solid transparent; cursor:pointer; padding:0; }
  .theme-dot[data-t="day"]{ background:#f4f0e4; box-shadow: inset 0 0 0 1px #cfc4a0; }
  .theme-dot[data-t="night"]{ background:#14171a; box-shadow: inset 0 0 0 1px #444; }
  .theme-dot[data-t="sepia"]{ background:#e6d7b3; box-shadow: inset 0 0 0 1px #b39d68; }
  .theme-dot.active{ border-color:var(--accent); }

  .btn-new{
    display:flex; align-items:center; gap:6px; padding:8px 16px; border-radius:20px;
    border:1px solid var(--accent); background:var(--accent); color:var(--surface);
    font-size:0.86rem; cursor:pointer; white-space:nowrap;
    transition:filter .15s ease, transform .1s ease;
  }
  .btn-new:hover{ filter:brightness(1.08); }
  .btn-new:active{ transform:scale(.97); }
  .btn-new svg{ width:15px; height:15px; }

  /* ===== منطقة العرض ===== */
  .view{ flex:1; min-height:0; position:relative; overflow:hidden; }
  .screen{
    position:absolute; inset:0; overflow-y:auto; overflow-x:hidden;
    opacity:0; transform:translateY(10px) scale(.99); pointer-events:none;
    transition: opacity .32s cubic-bezier(.22,.61,.36,1), transform .32s cubic-bezier(.22,.61,.36,1);
  }
  .screen.active{ opacity:1; transform:translateY(0) scale(1); pointer-events:auto; }

  /* ===== المكتبة ===== */
  .library-wrap{ max-width:1100px; margin:0 auto; padding:34px 26px 60px; }

  .empty-state{
    display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center;
    padding:80px 20px; gap:18px; color:var(--ink-soft); animation:riseIn .5s ease both;
  }
  .empty-state .glyph{
    width:74px; height:74px; border-radius:50%; border:1.5px dashed var(--line);
    display:flex; align-items:center; justify-content:center; color:var(--accent-2);
    font-family:'Aref Ruqaa', serif; font-size:2rem;
  }
  .empty-state h2{ font-family:'Aref Ruqaa', serif; font-size:1.5rem; color:var(--ink); margin:0; font-weight:400; }
  .empty-state p{ max-width:380px; line-height:2; margin:0; font-size:0.95rem; }
  .empty-state .btn-new{ margin-top:6px; padding:10px 22px; font-size:0.9rem; }

  .shelf-label{ display:flex; align-items:baseline; gap:10px; margin:0 0 20px; color:var(--ink-soft); font-size:0.85rem; }
  .shelf-label b{ font-family:'Aref Ruqaa', serif; color:var(--ink); font-size:1.1rem; font-weight:400; }

  .book-grid{ display:grid; grid-template-columns:repeat(auto-fill, minmax(160px, 1fr)); gap:26px 22px; }
  .book-card{ display:flex; flex-direction:column; cursor:pointer; animation:riseIn .4s ease both; }
  .book-card .spine{
    position:relative; height:210px; border-radius:4px 8px 8px 4px;
    box-shadow:0 10px 24px var(--shadow), inset 0 0 0 1px rgba(0,0,0,0.08);
    display:flex; flex-direction:column; align-items:center; justify-content:space-between;
    padding:18px 10px; transition:transform .22s cubic-bezier(.22,.61,.36,1), box-shadow .22s ease;
    text-align:center; overflow:hidden;
  }
  .book-card .spine::before{
    content:""; position:absolute; inset-inline-start:0; top:0; bottom:0; width:8px;
    background:rgba(0,0,0,0.15);
  }
  .book-card .spine::after{
    content:""; position:absolute; inset:0;
    background:linear-gradient(135deg, rgba(255,255,255,0.16), transparent 55%);
    pointer-events:none;
  }
  .book-card:hover .spine{ transform:translateY(-6px); box-shadow:0 18px 32px var(--shadow), inset 0 0 0 1px rgba(0,0,0,0.08); }
  .book-card .spine-title{
    font-family:'Aref Ruqaa', serif; font-size:1.15rem; line-height:1.5; color:#fdf9ef;
    text-shadow:0 1px 3px rgba(0,0,0,0.35); word-break:break-word;
  }
  .book-card .spine-glyph{ font-family:'Aref Ruqaa', serif; font-size:1.4rem; color:rgba(255,255,255,0.55); }
  .book-card .meta{ padding:10px 4px 0; text-align:center; }
  .book-card .meta .t{ font-size:0.88rem; color:var(--ink); font-family:'Cairo', sans-serif; font-weight:600; }
  .book-card .meta .d{ font-size:0.72rem; color:var(--ink-soft); margin-top:2px; }

  .book-card .card-actions{ position:absolute; top:8px; left:8px; display:flex; gap:4px; opacity:0; transition:opacity .15s ease; }
  .book-card:hover .card-actions{ opacity:1; }
  .card-actions button{
    width:26px; height:26px; border-radius:50%; border:none; background:rgba(0,0,0,0.32); color:#fff;
    display:flex; align-items:center; justify-content:center; cursor:pointer;
  }
  .card-actions button:hover{ background:rgba(0,0,0,0.5); }
  .card-actions svg{ width:13px; height:13px; }

  @keyframes riseIn{ from{ opacity:0; transform:translateY(14px); } to{ opacity:1; transform:translateY(0); } }

  /* ===== محرر الكتاب ===== */
  .editor-wrap{ max-width:880px; margin:0 auto; padding:26px 26px 80px; min-height:100%; position:relative; }

  .editor-head{
    display:flex; align-items:center; gap:12px; margin-bottom:22px; flex-wrap:wrap;
  }
  .back-btn{
    display:flex; align-items:center; gap:6px; background:transparent; border:none;
    color:var(--ink-soft); font-family:'Cairo',sans-serif; font-size:0.85rem;
    cursor:pointer; padding:6px 4px;
  }
  .back-btn:hover{ color:var(--accent); }
  .back-btn svg{ width:16px; height:16px; }

  .title-field{
    flex:1; min-width:150px; background:transparent; border:none;
    border-bottom:1.5px solid transparent;
    font-family:'Aref Ruqaa', serif; font-size:1.7rem; color:var(--ink);
    padding:4px 2px; text-align:center;
  }
  .title-field:focus{ outline:none; border-bottom-color:var(--accent); }
  .title-field::placeholder{ color:var(--ink-soft); opacity:0.6; }

  .editor-actions{ display:flex; gap:8px; }
  .action-btn{
    padding:6px 16px; border-radius:18px; border:1px solid var(--line);
    background:var(--bg); color:var(--ink); cursor:pointer; font-family:'Cairo',sans-serif; font-size:0.8rem;
  }
  .action-btn:hover{ background:var(--accent); color:var(--surface); border-color:var(--accent); }
  .action-btn.primary{ background:var(--accent); color:var(--surface); border-color:var(--accent); }
  .action-btn.primary:hover{ filter:brightness(1.1); }

  .save-status{
    font-size:0.74rem; color:var(--ink-soft); font-family:'Cairo',sans-serif;
    display:flex; align-items:center; gap:5px; min-width:60px; justify-content:flex-end;
  }
  .save-status .dot{ width:6px; height:6px; border-radius:50%; background:var(--accent-2); transition:opacity .3s ease; }
  .save-status.saving .dot{ animation:pulse 1s ease infinite; }
  @keyframes pulse{ 0%,100%{opacity:.4;} 50%{opacity:1;} }

  /* اللون يظهر فقط في وضع التحرير */
  .color-edit-area {
    display:none; align-items:center; gap:14px; justify-content:center;
    margin-bottom:20px; flex-wrap:wrap;
  }
  .color-edit-area.visible { display:flex; }
  .color-edit-area label{ font-size:0.85rem; color:var(--ink-soft); }
  .color-edit-area input[type="color"]{
    width:40px; height:40px; border:2px solid var(--line); border-radius:50%;
    padding:2px; cursor:pointer; background:transparent;
  }
  .color-preview{
    display:inline-block; width:30px; height:30px; border-radius:50%;
    border:2px solid var(--line);
  }

  .page-surface{
    background:var(--page-bg); border-radius:6px;
    box-shadow:0 14px 36px var(--shadow), inset 0 0 0 1px rgba(0,0,0,0.05);
    padding:46px 8vw; min-height:60vh; transition:background .35s ease;
  }
  .page-surface[contenteditable="true"]:focus{ outline:none; }
  .page-surface[contenteditable="false"]{ cursor:default; opacity:0.85; }
  .page-surface{ font-family:'Amiri', serif; font-size:1.28rem; line-height:2.6; color:var(--ink); white-space:pre-wrap; word-wrap:break-word; }
  .page-surface:empty::before{ content: attr(data-placeholder); color:var(--ink-soft); opacity:0.55; }

  /* تمييز نتيجة البحث داخل النص */
  .page-surface mark.search-highlight {
    background:var(--accent-2); color:var(--surface); padding:0 4px; border-radius:3px;
  }

  .editor-foot{ display:flex; justify-content:space-between; align-items:center; margin-top:14px; color:var(--ink-soft); font-family:'Cairo',sans-serif; font-size:0.76rem; }

  /* ===== نافذة تأكيد الحذف ===== */
  .modal-backdrop{
    position:fixed; inset:0; background:rgba(20,17,12,0.45);
    display:flex; align-items:center; justify-content:center; z-index:100;
    opacity:0; pointer-events:none; transition:opacity .22s ease;
  }
  .modal-backdrop.open{ opacity:1; pointer-events:auto; }
  .modal-box{
    background:var(--surface); border-radius:8px; padding:26px 26px 20px;
    width:min(90vw, 340px); box-shadow:0 20px 50px rgba(0,0,0,0.35);
    transform:translateY(10px) scale(.97); transition:transform .22s ease;
    text-align:center;
  }
  .modal-backdrop.open .modal-box{ transform:translateY(0) scale(1); }
  .modal-box h3{ font-family:'Aref Ruqaa', serif; font-weight:400; font-size:1.2rem; margin:0 0 8px; color:var(--ink); }
  .modal-box p{ font-size:0.85rem; color:var(--ink-soft); line-height:1.9; margin:0 0 18px; }
  .modal-actions{ display:flex; gap:10px; justify-content:center; }
  .modal-actions button{
    padding:8px 18px; border-radius:18px; font-size:0.82rem; cursor:pointer;
    border:1px solid var(--line); background:transparent; color:var(--ink);
  }
  .modal-actions .danger{ border-color:#a33; background:#a33; color:#fff; }
  .modal-actions .danger:hover{ filter:brightness(1.1); }
  .modal-actions button:not(.danger):hover{ background:var(--bg-2); }

  @media (max-width: 620px){
    .brand b{ font-size:1.05rem; }
    .search-wrap{ max-width:200px; }
    .book-grid{ grid-template-columns:repeat(auto-fill, minmax(130px, 1fr)); gap:20px 14px; }
    .book-card .spine{ height:170px; }
    .page-surface{ padding:34px 6vw; font-size:1.15rem; }
    .title-field{ font-size:1.35rem; }
  }
</style>
</head>
<body data-theme="day">

<div class="app">

  <div class="topbar">
    <div class="brand" id="brandHome" title="مكتبتي">
      <span class="mark">م</span>
      <b>مكتبتي</b>
    </div>

    <div class="tb-sep"></div>

    <div class="search-wrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      <input type="text" id="searchInput" placeholder="ابحث في الكتب والأبيات..." autocomplete="off">
      <div id="searchResults"></div>
    </div>

    <div class="nav-cluster">
      <div class="theme-switch" role="group" aria-label="تبديل الثيم">
        <button class="theme-dot" data-t="day" title="نهاري" aria-label="ثيم نهاري"></button>
        <button class="theme-dot" data-t="sepia" title="سيبيا" aria-label="ثيم سيبيا"></button>
        <button class="theme-dot" data-t="night" title="ليلي" aria-label="ثيم ليلي"></button>
      </div>
      <button class="btn-new" id="btnNewBook">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        كتاب جديد
      </button>
    </div>
  </div>

  <div class="view">
    <!-- شاشة المكتبة -->
    <div class="screen active" id="screenLibrary">
      <div class="library-wrap" id="libraryWrap"></div>
    </div>

    <!-- شاشة المحرر -->
    <div class="screen" id="screenEditor">
      <div class="editor-wrap">
        <div class="editor-head">
          <button class="back-btn" id="btnBack">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
            المكتبة
          </button>
          <input type="text" class="title-field" id="titleField" placeholder="عنوان الكتاب…" maxlength="80">
          <div class="editor-actions">
            <button class="action-btn" id="btnEdit">✏️ تعديل</button>
            <button class="action-btn primary" id="btnSave" style="display:none;">💾 حفظ</button>
          </div>
          <div class="save-status" id="saveStatus"><span class="dot"></span><span id="saveStatusText">محفوظ</span></div>
        </div>

        <!-- منطقة اختيار اللون (تظهر فقط عند التعديل) -->
        <div class="color-edit-area" id="colorEditArea">
          <label for="colorPickerInput">لون الغلاف:</label>
          <input type="color" id="colorPickerInput" value="#7a2e4e">
          <span class="color-preview" id="colorPreview" style="background:#7a2e4e;"></span>
        </div>

        <div class="page-surface" id="pageSurface" contenteditable="false" data-placeholder="ابدأ الكتابة هنا…"></div>

        <div class="editor-foot">
          <span id="wordCount">0 كلمة</span>
          <span id="updatedAt"></span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal-backdrop" id="modalBackdrop">
  <div class="modal-box">
    <h3>حذف الكتاب</h3>
    <p id="modalText">هل تريد حذف هذا الكتاب نهائيًا؟ لا يمكن التراجع عن هذا الإجراء.</p>
    <div class="modal-actions">
      <button id="modalCancel">إلغاء</button>
      <button class="danger" id="modalConfirm">حذف</button>
    </div>
  </div>
</div>

<script>
(function(){
  "use strict";

  var STORAGE_KEY = "maktabati_books_v4";
  var THEME_KEY = "maktabati_theme_v1";

  var els = {
    libraryWrap: document.getElementById("libraryWrap"),
    screenLibrary: document.getElementById("screenLibrary"),
    screenEditor: document.getElementById("screenEditor"),
    btnNewBook: document.getElementById("btnNewBook"),
    brandHome: document.getElementById("brandHome"),
    btnBack: document.getElementById("btnBack"),
    titleField: document.getElementById("titleField"),
    pageSurface: document.getElementById("pageSurface"),
    colorPickerInput: document.getElementById("colorPickerInput"),
    colorPreview: document.getElementById("colorPreview"),
    colorEditArea: document.getElementById("colorEditArea"),
    saveStatus: document.getElementById("saveStatus"),
    saveStatusText: document.getElementById("saveStatusText"),
    wordCount: document.getElementById("wordCount"),
    updatedAt: document.getElementById("updatedAt"),
    searchInput: document.getElementById("searchInput"),
    searchResults: document.getElementById("searchResults"),
    themeDots: Array.prototype.slice.call(document.querySelectorAll(".theme-dot")),
    modalBackdrop: document.getElementById("modalBackdrop"),
    modalText: document.getElementById("modalText"),
    modalCancel: document.getElementById("modalCancel"),
    modalConfirm: document.getElementById("modalConfirm"),
    btnEdit: document.getElementById("btnEdit"),
    btnSave: document.getElementById("btnSave")
  };

  var books = [];
  var currentId = null;
  var pendingDeleteId = null;
  var isEditing = false;
  var highlightTerm = null;   // الكلمة المراد تمييزها عند فتح الكتاب

  /* ---------- تخزين ---------- */
  function loadBooks(){
    try{
      var raw = localStorage.getItem(STORAGE_KEY);
      books = raw ? JSON.parse(raw) : [];
      books.forEach(function(b){ if(!b.tracks) b.tracks = []; });
    }catch(e){ books = []; }
  }
  function persist(){
    try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(books)); }catch(e){}
  }

  function uid(){ return "b_" + Date.now().toString(36) + "_" + Math.random().toString(36).slice(2,8); }

  function formatDate(ts){
    var d = new Date(ts);
    var months = ["يناير","فبراير","مارس","أبريل","مايو","يونيو","يوليو","أغسطس","سبتمبر","أكتوبر","نوفمبر","ديسمبر"];
    return d.getDate() + " " + months[d.getMonth()] + " " + d.getFullYear();
  }

  function escapeHtml(s){
    return String(s).replace(/[&<>"']/g, function(c){
      return { "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" }[c];
    });
  }

  /* ---------- دالة إزالة التشكيل ---------- */
  function removeDiacritics(text) {
    return text.replace(/[\u064B-\u065F\u0670]/g, '');
  }

  /* ---------- عرض المكتبة ---------- */
  function renderLibrary(filter){
    filter = (filter || "").trim().toLowerCase();
    var list = books.slice().sort(function(a,b){ return b.updatedAt - a.updatedAt; });
    if(filter){
      // نبحث في العناوين فقط (لأننا سنعرض النتائج في القائمة المنبثقة)
      list = list.filter(function(b){
        return removeDiacritics(b.title || "").toLowerCase().indexOf(filter) !== -1;
      });
    }

    els.libraryWrap.innerHTML = "";

    if(books.length === 0){
      var empty = document.createElement("div");
      empty.className = "empty-state";
      empty.innerHTML =
        '<div class="glyph">؟</div>' +
        '<h2>مكتبتك فارغة الآن</h2>' +
        '<p>أنشئ كتابك الأول، اختر له اسمًا ولونًا، واكتب نصك بحرية — سيُحفظ عند الضغط على "حفظ".</p>' +
        '<button class="btn-new" id="emptyNewBtn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>ابدأ كتابًا جديدًا</button>';
      els.libraryWrap.appendChild(empty);
      document.getElementById("emptyNewBtn").addEventListener("click", createNewBook);
      return;
    }

    var label = document.createElement("div");
    label.className = "shelf-label";
    label.innerHTML = "<b>رفّي</b><span>" + books.length + " كتاب" + (books.length > 1 ? "ًا" : "") + "</span>";
    els.libraryWrap.appendChild(label);

    if(list.length === 0 && filter){
      var noRes = document.createElement("p");
      noRes.style.color = "var(--ink-soft)";
      noRes.style.fontSize = "0.9rem";
      noRes.textContent = "لا توجد كتب تطابق البحث.";
      els.libraryWrap.appendChild(noRes);
      return;
    }

    var grid = document.createElement("div");
    grid.className = "book-grid";

    list.forEach(function(book, idx){
      var color = book.color || "#7a2e4e";
      var card = document.createElement("div");
      card.className = "book-card";
      card.style.animationDelay = (idx * 0.03) + "s";

      var words = (book.text || "").trim();
      var wc = words ? words.split(/\s+/).length : 0;

      card.innerHTML =
        '<div class="spine" style="background:linear-gradient(160deg,' + color + ',' + darken(color, 0.3) + ')">' +
          '<div class="card-actions">' +
            '<button class="delBtn" title="حذف"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2m-9 0 1 14h8l1-14"/></svg></button>' +
          '</div>' +
          '<span class="spine-glyph">﴾</span>' +
          '<span class="spine-title">' + escapeHtml(book.title || "بلا عنوان") + '</span>' +
          '<span class="spine-glyph">﴿</span>' +
        '</div>' +
        '<div class="meta">' +
          '<div class="t">' + escapeHtml(book.title || "بلا عنوان") + '</div>' +
          '<div class="d">' + wc + ' كلمة · ' + formatDate(book.updatedAt) + '</div>' +
        '</div>';

      card.addEventListener("click", function(e){
        if(e.target.closest(".delBtn")) return;
        openBook(book.id, null); // بدون تمييز
      });
      card.querySelector(".delBtn").addEventListener("click", function(e){
        e.stopPropagation();
        askDelete(book.id);
      });

      grid.appendChild(card);
    });

    els.libraryWrap.appendChild(grid);
  }

  function darken(hex, amount){
    var r = parseInt(hex.slice(1,3), 16);
    var g = parseInt(hex.slice(3,5), 16);
    var b = parseInt(hex.slice(5,7), 16);
    r = Math.floor(r * (1 - amount));
    g = Math.floor(g * (1 - amount));
    b = Math.floor(b * (1 - amount));
    return "#" + [r,g,b].map(function(c){ return c.toString(16).padStart(2,'0'); }).join('');
  }

  /* ---------- إدارة الكتب ---------- */
  function createNewBook(){
    var book = {
      id: uid(),
      title: "",
      color: "#7a2e4e",
      text: "",
      createdAt: Date.now(),
      updatedAt: Date.now()
    };
    books.unshift(book);
    persist();
    openBook(book.id, null);
  }

  function openBook(id, highlight){
    var book = findBook(id);
    if(!book) return;
    currentId = id;

    // تعطيل التحرير افتراضياً
    isEditing = false;
    els.pageSurface.contentEditable = "false";
    els.btnEdit.style.display = "inline-block";
    els.btnSave.style.display = "none";
    els.colorEditArea.classList.remove("visible");

    els.titleField.value = book.title || "";
    els.pageSurface.textContent = book.text || "";
    // إزالة أي تمييز سابق
    clearHighlights();
    // إذا كان هناك كلمة للتمييز
    if(highlight) {
      highlightTerm = highlight;
      highlightText(highlight);
    } else {
      highlightTerm = null;
    }
    updateWordCount();
    els.updatedAt.textContent = "آخر تحديث: " + formatDate(book.updatedAt);
    setSaved(true);

    // تطبيق اللون
    var color = book.color || "#7a2e4e";
    els.colorPickerInput.value = color;
    els.colorPreview.style.background = color;

    showScreen("editor");
    setTimeout(function(){
      if(!book.title){ els.titleField.focus(); }
    }, 320);
  }

  function findBook(id){
    for(var i=0;i<books.length;i++){ if(books[i].id === id) return books[i]; }
    return null;
  }

  function updateWordCount(){
    var text = els.pageSurface.textContent.trim();
    var n = text ? text.split(/\s+/).length : 0;
    els.wordCount.textContent = n + " كلمة";
  }

  function setSaved(isSaved){
    els.saveStatus.classList.toggle("saving", !isSaved);
    els.saveStatusText.textContent = isSaved ? "محفوظ" : "غير محفوظ";
  }

  /* ---------- التحرير والحفظ ---------- */
  els.btnEdit.addEventListener("click", function(){
    if(!currentId) return;
    isEditing = true;
    els.pageSurface.contentEditable = "true";
    els.btnEdit.style.display = "none";
    els.btnSave.style.display = "inline-block";
    els.colorEditArea.classList.add("visible");
    els.pageSurface.focus();
    setSaved(true);
  });

  els.btnSave.addEventListener("click", function(){
    if(!currentId) return;
    doSave();
    isEditing = false;
    els.pageSurface.contentEditable = "false";
    els.btnEdit.style.display = "inline-block";
    els.btnSave.style.display = "none";
    els.colorEditArea.classList.remove("visible");
    setSaved(true);
  });

  function doSave(){
    var book = findBook(currentId);
    if(!book) return;
    book.title = els.titleField.value.trim();
    book.text = els.pageSurface.textContent;
    book.updatedAt = Date.now();
    // حفظ اللون
    book.color = els.colorPickerInput.value;
    persist();
    els.updatedAt.textContent = "آخر تحديث: " + formatDate(book.updatedAt);
    setSaved(true);
  }

  /* ---------- تغيير اللون (يحدث أثناء التحرير) ---------- */
  els.colorPickerInput.addEventListener("input", function(){
    var color = els.colorPickerInput.value;
    els.colorPreview.style.background = color;
    // نحدّث الكتاب فوراً (لكن ننتظر حتى الحفظ لتثبيت التغيير)
    var book = findBook(currentId);
    if(book) book.color = color;
  });

  /* ---------- البحث المتقدم ---------- */
  function performSearch(query){
    var resultsDiv = els.searchResults;
    if(!query.trim()){
      resultsDiv.style.display = "none";
      return;
    }
    var normalizedQuery = removeDiacritics(query.trim().toLowerCase());
    var results = [];

    books.forEach(function(book){
      var title = book.title || "";
      var text = book.text || "";
      var normalizedTitle = removeDiacritics(title.toLowerCase());
      var normalizedText = removeDiacritics(text.toLowerCase());

      // البحث في العنوان
      if(normalizedTitle.indexOf(normalizedQuery) !== -1){
        results.push({
          bookId: book.id,
          bookTitle: title,
          snippet: title,
          matchType: "title"
        });
      }

      // البحث في النص
      var index = normalizedText.indexOf(normalizedQuery);
      if(index !== -1){
        // استخراج نص محيط (حوالي 40 حرفاً قبل وبعد)
        var start = Math.max(0, index - 40);
        var end = Math.min(text.length, index + normalizedQuery.length + 40);
        var snippet = text.substring(start, end);
        // إضافة تمييز داخل الـ snippet (لكن سنميز الكلمة في العرض)
        var highlightedSnippet = snippet.replace(new RegExp(query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi'), function(match){
          return '<mark>' + match + '</mark>';
        });
        results.push({
          bookId: book.id,
          bookTitle: title,
          snippet: highlightedSnippet,
          matchType: "text",
          matchStart: index,
          matchEnd: index + normalizedQuery.length
        });
      }
    });

    // عرض النتائج
    if(results.length === 0){
      resultsDiv.innerHTML = '<div class="no-results">لا توجد نتائج</div>';
      resultsDiv.style.display = "block";
      return;
    }

    // نعرض أول 10 نتائج
    var html = '';
    results.slice(0, 10).forEach(function(res){
      html += '<div class="result-item" data-bookid="'+res.bookId+'" data-matchstart="'+(res.matchStart||'')+'" data-matchend="'+(res.matchEnd||'')+'" data-query="'+escapeHtml(query)+'">';
      html += '<div class="book-title">📖 ' + escapeHtml(res.bookTitle) + '</div>';
      if(res.matchType === "text") {
        html += '<span class="snippet">' + res.snippet + '</span>';
      } else {
        html += '<span class="snippet" style="color:var(--ink-soft)">(عنوان)</span>';
      }
      html += '</div>';
    });
    resultsDiv.innerHTML = html;
    resultsDiv.style.display = "block";

    // ربط أحداث النقر على النتائج
    resultsDiv.querySelectorAll('.result-item').forEach(function(item){
      item.addEventListener('click', function(e){
        var bookId = this.dataset.bookid;
        var query = this.dataset.query;
        var matchStart = parseInt(this.dataset.matchstart);
        var matchEnd = parseInt(this.dataset.matchend);
        // نغلق نتائج البحث
        resultsDiv.style.display = "none";
        els.searchInput.value = "";
        // نفتح الكتاب مع تمييز الكلمة
        if(bookId){
          openBook(bookId, query);
        }
      });
    });
  }

  /* ---------- تمييز النص في المحرر ---------- */
  function clearHighlights(){
    // نزيل أي علامات تمييز سابقة
    var surface = els.pageSurface;
    var html = surface.innerHTML;
    // نزيل أي <mark> موجود
    html = html.replace(/<mark[^>]*>|<\/mark>/g, '');
    surface.innerHTML = html;
  }

  function highlightText(query){
    if(!query) return;
    var surface = els.pageSurface;
    var text = surface.textContent;
    var normalizedText = removeDiacritics(text);
    var normalizedQuery = removeDiacritics(query);
    var index = normalizedText.toLowerCase().indexOf(normalizedQuery.toLowerCase());
    if(index === -1) return;

    // نقسم النص إلى ثلاث أجزاء: قبل، الكلمة، بعد
    var before = text.substring(0, index);
    var match = text.substring(index, index + query.length);
    // نبحث عن الكلمة الأصلية (قد تختلف بسبب التشكيل) فنأخذ المطابقة من النص الأصلي
    // ولكننا نستخدم substring بنفس الطول
    var after = text.substring(index + query.length);

    // نعيد بناء الـ HTML مع تمييز
    surface.innerHTML = escapeHtml(before) + '<mark class="search-highlight">' + escapeHtml(match) + '</mark>' + escapeHtml(after);
  }

  /* ---------- الحذف ---------- */
  function askDelete(id){
    pendingDeleteId = id;
    var book = findBook(id);
    els.modalText.textContent = 'هل تريد حذف كتاب "' + (book ? (book.title || "بلا عنوان") : "") + '" نهائيًا؟ لا يمكن التراجع عن هذا الإجراء.';
    els.modalBackdrop.classList.add("open");
  }
  els.modalCancel.addEventListener("click", function(){
    pendingDeleteId = null;
    els.modalBackdrop.classList.remove("open");
  });
  els.modalConfirm.addEventListener("click", function(){
    if(pendingDeleteId){
      books = books.filter(function(b){ return b.id !== pendingDeleteId; });
      persist();
      if(currentId === pendingDeleteId){
        currentId = null;
        showScreen("library");
      }
      renderLibrary(els.searchInput.value);
    }
    pendingDeleteId = null;
    els.modalBackdrop.classList.remove("open");
  });
  els.modalBackdrop.addEventListener("click", function(e){
    if(e.target === els.modalBackdrop){ els.modalCancel.click(); }
  });

  /* ---------- تنقّل الشاشات ---------- */
  function showScreen(name){
    if(name === "library"){
      renderLibrary(els.searchInput.value);
      els.screenEditor.classList.remove("active");
      els.screenLibrary.classList.add("active");
    } else {
      els.screenLibrary.classList.remove("active");
      els.screenEditor.classList.add("active");
    }
  }

  function goBackToLibrary(){
    if(currentId && isEditing){
      if(confirm("لديك تغييرات غير محفوظة. هل تريد الحفظ قبل الخروج؟")){
        doSave();
        isEditing = false;
        els.pageSurface.contentEditable = "false";
        els.btnEdit.style.display = "inline-block";
        els.btnSave.style.display = "none";
        els.colorEditArea.classList.remove("visible");
      }
    } else if(currentId){
      doSave();
    }
    currentId = null;
    highlightTerm = null;
    els.searchInput.value = "";
    els.searchResults.style.display = "none";
    showScreen("library");
  }

  els.btnNewBook.addEventListener("click", createNewBook);
  els.brandHome.addEventListener("click", goBackToLibrary);
  els.btnBack.addEventListener("click", goBackToLibrary);

  els.titleField.addEventListener("input", function(){
    if(isEditing) setSaved(false);
  });
  els.pageSurface.addEventListener("input", function(){
    if(isEditing){ updateWordCount(); setSaved(false); }
  });

  // البحث الفوري
  els.searchInput.addEventListener("input", function(){
    var query = this.value;
    if(query.trim().length > 0){
      performSearch(query);
    } else {
      els.searchResults.style.display = "none";
    }
  });

  // إغلاق نتائج البحث عند النقر خارجها
  document.addEventListener("click", function(e){
    if(!e.target.closest(".search-wrap")){
      els.searchResults.style.display = "none";
    }
  });

  window.addEventListener("keydown", function(e){
    if((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "s"){
      e.preventDefault();
      if(currentId && isEditing) doSave();
    }
    if(e.key === "Escape" && els.modalBackdrop.classList.contains("open")){
      els.modalCancel.click();
    }
  });

  window.addEventListener("beforeunload", function(){
    if(currentId) doSave();
  });

  /* ---------- الثيمات ---------- */
  function applyTheme(t){
    document.body.setAttribute("data-theme", t);
    els.themeDots.forEach(function(d){ d.classList.toggle("active", d.getAttribute("data-t") === t); });
    try{ localStorage.setItem(THEME_KEY, t); }catch(e){}
  }
  els.themeDots.forEach(function(dot){
    dot.addEventListener("click", function(){ applyTheme(dot.getAttribute("data-t")); });
  });

  /* ---------- بدء التشغيل ---------- */
  function init(){
    loadBooks();
    var savedTheme = "day";
    try{ savedTheme = localStorage.getItem(THEME_KEY) || "day"; }catch(e){}
    applyTheme(savedTheme);
    renderLibrary("");
  }

  init();
})();
</script>
